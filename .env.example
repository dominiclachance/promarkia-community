# Optional server overrides. Model/API keys should normally be stored through
# the encrypted API Keys panel in the local UI.
PROMARKIA_DATA_DIR=./data
PROMARKIA_HOST=127.0.0.1
PROMARKIA_PORT=8788
PROMARKIA_NO_BROWSER=0

# Required only when an external provider must fetch a locally generated file.
# Keep the default loopback URL unless you intentionally operate a secured,
# externally reachable asset endpoint.
PROMARKIA_PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8788/files/user
